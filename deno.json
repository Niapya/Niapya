{
  "imports": {
    "@resvg/resvg-js": "npm:@resvg/resvg-js@^2.6.2",
    "@twind/core": "npm:@twind/core@^1.1.3",
    "@twind/preset-autoprefix": "npm:@twind/preset-autoprefix@^1.0.7",
    "@twind/preset-tailwind": "npm:@twind/preset-tailwind@^1.1.4",
    "@twind/preset-typography": "npm:@twind/preset-typography@^1.0.7",
    "clsx": "npm:clsx@^2.1.1",
    "fast-diff": "npm:fast-diff@^1.3.0",
    "lucide": "npm:lucide@^1.26.0",
    "prismjs": "npm:prismjs@^1.30.0",
    "remix": "npm:remix@^3.0.0-beta.5",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@/": "./app/",
    "satori": "npm:satori@^0.29.0",
    "simple-icons": "npm:simple-icons@^16.27.0",
    "tailwind-merge": "npm:tailwind-merge@2.6.0"
  },
  "tasks": {
    "dev": "NODE_ENV=development deno run --unstable-no-legacy-abort --unstable-kv --watch --allow-env --allow-ffi --allow-read --allow-net deno.ts",
    "start": "NODE_ENV=production deno run --unstable-no-legacy-abort --unstable-kv --allow-env --allow-ffi --allow-read --allow-net deno.ts",
    "test": "NODE_ENV=test deno test --unstable-kv --allow-env --allow-ffi --allow-read --allow-net",
    "cache": "deno cache deno.ts",
    "check": "deno check --unstable-kv app/ deno.ts && deno lint",
    "fix": "deno fmt && deno lint --fix"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "skipLibCheck": true
  },
  "nodeModulesDir": "auto",
  "include": [
    "app/",
    "deno.ts"
  ],
  "exclude": [
    ".tmp/",
    "node_modules/"
  ],
  "lint": {
    "plugins": [
      "jsr:@ryu/deno-lint-plugin-tailwindcss@0.2.0"
    ],
    "include": [
      "./app/",
      "./deno.ts"
    ],
    "exclude": [
      "node_modules/"
    ]
  },
  "fmt": {
    "include": [
      "./app/",
      "./tailwind.config.cjs",
      "./deno.ts"
    ],
    "exclude": [
      "node_modules/"
    ]
  }
}
