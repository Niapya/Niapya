{
  "imports": {
    "@resvg/resvg-js": "npm:@resvg/resvg-js@^2.6.2",
    "@twind/core": "npm:@twind/core@^1.1.3",
    "@twind/preset-autoprefix": "npm:@twind/preset-autoprefix@^1.0.7",
    "@twind/preset-tailwind": "npm:@twind/preset-tailwind@^1.1.4",
    "fast-diff": "npm:fast-diff@^1.3.0",
    "remix": "npm:remix@^3.0.0-beta.5",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@/": "./app/",
    "satori": "npm:satori@^0.29.0"
  },
  "tasks": {
    "dev": "NODE_ENV=development deno run --unstable-no-legacy-abort --unstable-raw-imports --watch --allow-env --allow-ffi --allow-read --allow-net deno.ts",
    "start": "NODE_ENV=production deno run --unstable-no-legacy-abort --unstable-raw-imports --allow-env --allow-ffi --allow-read --allow-net deno.ts",
    "test": "NODE_ENV=test deno test --unstable-raw-imports --allow-env --allow-ffi --allow-read --allow-net",
    "check": "deno check --unstable-raw-imports app/ deno.ts && deno lint",
    "format": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "skipLibCheck": true
  },
  "nodeModulesDir": "auto",
  "include": [
    "app/",
    "deno.ts"
  ],
  "exclude": [
    ".tmp/",
    "node_modules/"
  ],
  "lint": {
    "include": [
      "./app/",
      "./deno.ts"
    ],
    "exclude": [
      "node_modules/"
    ]
  },
  "fmt": {
    "include": [
      "./app/",
      "./deno.ts"
    ],
    "exclude": [
      "node_modules/"
    ]
  }
}
